# ==========================================
# CẤU HÌNH HỆ THỐNG MÔI TRƯỜNG (ENVIRONMENT)
# ==========================================

# Môi trường chạy: development | testing | production
APP_ENV=development
APP_NAME="Hệ thống Phát hiện Thông tin Sai lệch Đa phương thức"
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# ==========================================
# CƠ SỞ DỮ LIỆU (DATABASE)
# Mặc định sử dụng SQLite cho môi trường Dev cục bộ
# Khi chạy Docker / Production đổi sang PostgreSQL:
# postgresql://postgres:postgres@localhost:5432/misinfo_db
# ==========================================
DATABASE_URL=sqlite:///./misinfo_dev.db

# ==========================================
# BẢO MẬT & XÁC THỰC (SECURITY & JWT)
# Khóa bí mật (dùng lệnh openssl rand -hex 32 để tạo chuỗi ngẫu nhiên khi production)
# ==========================================
SECRET_KEY=misinformation_detection_secret_key_vietnam_2026_super_secure_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# BẢO VỆ CHỐNG BRUTE FORCE (KHÓA TÀI KHOẢN)
# Khóa tài khoản 15 phút nếu đăng nhập sai quá 5 lần
# ==========================================
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ==========================================
# CẤU HÌNH THƯ MỤC UPLOAD MEDIA
# ==========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
