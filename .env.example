# =========================================================================
# CẤU HÌNH MẪU HỆ THỐNG PHÁT HIỆN THÔNG TIN SAI LỆCH ĐA PHƯƠNG THỨC (.env)
# =========================================================================

# 1. Thông tin chung ứng dụng
APP_NAME="Hệ thống Phát hiện Thông tin Sai lệch Đa phương thức"
APP_ENV="development" # development | production
DEBUG=true
APP_HOST="127.0.0.1"
APP_PORT=8000
API_V1_STR="/api/v1"

# 2. Cơ sở dữ liệu (SQLite cho máy phát triển, PostgreSQL cho Docker / Production)
# SQLite:
DATABASE_URL="sqlite:///./misinfo_dev.db"
# PostgreSQL (Docker):
# DATABASE_URL="postgresql://postgres:postgres_secure_password_2026@localhost:5432/misinfo_db"

# 3. Bảo mật JSON Web Token (JWT)
SECRET_KEY="misinformation_detection_secret_key_vietnam_2026_super_secure_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. Cơ chế phòng thủ Brute-force Login
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# 5. Lưu trữ Tệp tải lên
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# 6. Bộ nhớ đệm Mô hình Học sâu (Được khóa trên ổ D:)
HF_HOME="./data/huggingface"
TORCH_HOME="./data/torch"
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# 7. Tự động hóa nạp tri thức báo chí RSS (24/7)
RAG_AUTO_SYNC_ENABLED=true
RAG_AUTO_SYNC_INTERVAL_MINUTES=60

# 8. Frontend Vite Environment Variable (nếu build độc lập)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
