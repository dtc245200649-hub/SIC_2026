# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# C/C++ build artifacts & local libraries
# ==========================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Virtual Environments
# ==========================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Node.js & Frontend
# ==========================================
frontend/node_modules/
frontend/dist/
uploads/
*.sqlite3
*.db
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# IDE & Editors
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# Testing & Coverage
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ==========================================
# Databases & Storage
# ==========================================
*.sqlite3
*.db
backend/uploads/*
!backend/uploads/.gitkeep

# ==========================================
# Large AI Weights & Model Checkpoints
# (Do not commit binary model checkpoints > 100MB)
# ==========================================
*.pt
*.pth
*.bin
*.onnx
*.safetensors
ai_engine/checkpoints/*
!ai_engine/checkpoints/.gitkeep

# ==========================================
# OS Specific
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
